# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to the app bundle.
# Anything without that prefix stays out of the client build.

# Your Apple signing team, used by plugins/withSigningTeam.js so that the
# signing config survives `expo prebuild`. Find it in Xcode under
# Signing & Capabilities, or run:
#   grep DEVELOPMENT_TEAM ios/HealthTracker.xcodeproj/project.pbxproj
# Leave unset if you only build for the simulator.
# APPLE_TEAM_ID=

# Not needed yet -- V1 runs entirely on-device. These become relevant when
# Supabase sync is added.
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
