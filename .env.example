# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to the app bundle.
# Anything without that prefix stays out of the client build.
#
# Not needed yet -- V1 runs entirely on-device. These become relevant when
# Supabase sync is added.
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
