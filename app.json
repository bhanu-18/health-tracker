{
  "expo": {
    "name": "Almanac",
    "slug": "almanac",
    "scheme": "healthtracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bhanuteja.healthtracker"
    },
    "android": {
      "package": "com.bhanuteja.healthtracker",
      "adaptiveIcon": {
        "backgroundColor": "#1C1917",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Health Tracker reads your steps, sleep and active calories so your daily totals stay accurate without manual entry.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "./plugins/withSigningTeam"
    ]
  }
}
